---
interface Props {
  projects: {
    id: string
    title: string
    shortDescription: string
    longDescription?: string
    thumbnail?: string
    techStack: string[]
    category: string
    featured: boolean
    liveUrl?: string
    githubUrl?: string
    startDate: string
    endDate?: string
  }[]
}
const { projects } = Astro.props
const featuredProjects = projects.filter((p: any) => p.featured)
const otherProjects = projects.filter((p: any) => !p.featured)
---

<section id="projects" class="py-20 lg:py-32 bg-white dark:bg-gray-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <header class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-serif font-bold text-gray-900 dark:text-white mb-4">
        Featured Projects
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        Selected work spanning telecom training, cyber security, and academic research
      </p>
    </header>

    <!-- Featured Projects -->
    <div class="grid md:grid-cols-2 gap-8 mb-16">
      {featuredProjects.map((project: any) => (
        <article class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden hover:border-blue-200 dark:hover:border-blue-800 transition-all duration-300 group">
          <div class="aspect-video relative overflow-hidden">
            {project.thumbnail && (
              <img 
                src={project.thumbnail} 
                alt={project.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            )}
            {(!project.thumbnail) && (
              <div class="w-full h-full bg-gradient-to-br from-blue-500/20 to-purple-500/20 flex items-center justify-center">
                <span class="text-4xl">{project.category === 'Training & Education' ? '📚' : project.category === 'Cyber Security' ? '🔐' : '💻'}</span>
              </div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
          </div>
          <div class="p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-2 py-1 text-xs font-medium bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full">
                {project.category}
              </span>
              <span class="text-xs text-gray-500 dark:text-gray-400">
                {new Date(project.startDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
                {project.endDate && project.endDate !== 'present' && ` – ${new Date(project.endDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}`}
              </span>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              {project.title}
            </h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4 line-clamp-3">
              {project.shortDescription}
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              {project.techStack?.slice(0, 4).map((tech: string) => (
                <span class="px-2 py-1 text-xs bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded border border-gray-200 dark:border-gray-600">
                  {tech}
                </span>
              ))}
              {project.techStack && project.techStack.length > 4 && (
                <span class="px-2 py-1 text-xs bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-400 rounded border border-gray-200 dark:border-gray-600">
                  +{project.techStack.length - 4} more
                </span>
              )}
            </div>
            <div class="flex items-center gap-4 pt-4 border-t border-gray-200 dark:border-gray-700">
              {project.liveUrl && (
                <a 
                  href={project.liveUrl} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 flex items-center gap-1"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                  Live Demo
                </a>
              )}
              {project.githubUrl && (
                <a 
                  href={project.githubUrl} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 flex items-center gap-1"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                  </svg>
                  Code
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Other Projects (Collapsible) -->
    {otherProjects.length > 0 && (
      <details class="group">
        <summary class="cursor-pointer text-center py-4">
          <h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-2">
            Other Projects
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            Click to expand ({otherProjects.length} more projects)
          </p>
          <svg class="w-6 h-6 mx-auto mt-2 text-gray-400 group-open:rotate-180 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8 pt-8 border-t border-gray-200 dark:border-gray-700">
          {otherProjects.map((project: any) => (
            <article class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden hover:border-blue-200 dark:hover:border-blue-800 transition-all duration-300">
              <div class="aspect-video relative overflow-hidden">
                {project.thumbnail && (
                  <img 
                    src={project.thumbnail} 
                    alt={project.title}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                )}
                {(!project.thumbnail) && (
                  <div class="w-full h-full bg-gradient-to-br from-blue-500/20 to-purple-500/20 flex items-center justify-center">
                    <span class="text-4xl">{project.category === 'Training & Education' ? '📚' : project.category === 'Cyber Security' ? '🔐' : '💻'}</span>
                  </div>
                )}
              </div>
              <div class="p-6">
                <div class="flex items-center gap-2 mb-3">
                  <span class="px-2 py-1 text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded-full">
                    {project.category}
                  </span>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
                  {project.title}
                </h3>
                <p class="text-gray-600 dark:text-gray-400 text-sm mb-4 line-clamp-2">
                  {project.shortDescription}
                </p>
                <div class="flex flex-wrap gap-1 mb-4">
                  {project.techStack?.slice(0, 3).map((tech: string) => (
                    <span class="px-2 py-1 text-xs bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded border border-gray-200 dark:border-gray-600">
                      {tech}
                    </span>
                  ))}
                </div>
                <div class="flex items-center gap-3 pt-3 border-t border-gray-200 dark:border-gray-700">
                  {project.liveUrl && (
                    <a 
                      href={project.liveUrl} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      class="text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300"
                    >
                      Live Demo
                    </a>
                  )}
                  {project.githubUrl && (
                    <a 
                      href={project.githubUrl} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300"
                    >
                      Code
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </details>
    )}
  </div>
</section>